{
    "git.ignoreLimitWarning": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/main.aux": true,
        "**/main.log": true,
        "**/main.gz": true,
        "**/main.out": true
    },
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.autoBuild.enable": true,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.tools": [
        {
            "name": "tectonic",
            "command": "/usr/local/bin/tectonic",
            "args": [
                "--keep-intermediates",
                "--keep-logs",
                "%DOCFILE_EXT%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "tectonic",
            "tools": ["tectonic"]
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.chktex.enabled": false
}