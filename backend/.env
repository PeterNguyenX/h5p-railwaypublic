# Environment Variables for MAMP WordPress Integration

# ═══════════════════════════════════════════════════════════════════════════════
# AI SETUP - Using Ollama (FREE, Local, No Internet Needed)
# ═══════════════════════════════════════════════════════════════════════════════
# Ollama: Completely FREE, runs locally on your computer
# Speed: 5-15 tokens/sec | Models available: mistral, neural-chat, llama2
# Start Ollama: ollama pull mistral && ollama serve

# Enable Ollama as your AI provider
OLLAMA_ENABLED=true
OLLAMA_MODEL=mistral

# Groq API (FREE, fast cloud AI — takes priority over Ollama)
GROQ_API_KEY=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

# WordPress Configuration
WORDPRESS_URL=http://localhost:8888/h5p-wp
WORDPRESS_USER=your_wp_username
WORDPRESS_PASSWORD=your_wp_password

# LTI Configuration
LTI_SECRET=your-secret-key-for-lti-tokens-make-it-long-and-secure
APP_URL=http://localhost:3000

# MySQL Database Configuration (commented out - using SQLite instead)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=wordpress_db
# DB_USER=wordpress_user
# DB_PASSWORD=your_secure_password

# Database URL (commented out - using SQLite)
# DATABASE_URL=mysql://root:rootpassword@localhost:3306/wordpress_db

